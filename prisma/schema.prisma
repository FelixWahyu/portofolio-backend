datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id            String   @id @default(cuid())

  titleId       String   @map("title_id")
  titleEn       String   @map("title_en")
  descriptionId String   @map("description_id") @db.Text
  descriptionEn String   @map("description_en") @db.Text
  roleId        String   @map("role_id") @db.Text
  roleEn        String   @map("role_en") @db.Text
  problemId     String   @map("problem_id") @db.Text
  problemEn     String   @map("problem_en") @db.Text
  impactId      String   @map("impact_id") @db.Text
  impactEn      String   @map("impact_en") @db.Text
  featuresId    String[] @map("features_id")
  featuresEn    String[] @map("features_en")

  image         String
  category      String   @default("Web")
  tech          String[]
  demolink      String?  @map("demo_link")
  sourcelink    String?  @map("source_link")
  sortOrder     Int      @default(0) @map("sort_order")
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model Achievement {
  id              String   @id @default(cuid())

  titleId         String   @map("title_id")
  titleEn         String   @map("title_en")
  issuerTextId    String   @map("issuer_text_id")
  issuerTextEn    String   @map("issuer_text_en")
  descriptionId   String?  @map("description_id") @db.Text
  descriptionEn   String?  @map("description_en") @db.Text
  tagsId          String[] @map("tags_id")
  tagsEn          String[] @map("tags_en")
  dateId          String   @map("date_id")
  dateEn          String   @map("date_en")

  image           String
  type            String   @default("Profesional")
  credentialCode  String?  @map("credential_code")
  sortOrder       Int      @default(0) @map("sort_order")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("achievements")
}

model Experience {
  id                 String   @id @default(cuid())

  roleId             String   @map("role_id")
  roleEn             String   @map("role_en")
  companyId          String   @map("company_id")
  companyEn          String   @map("company_en")
  locationId         String   @map("location_id")
  locationEn         String   @map("location_en")
  periodId           String   @map("period_id")
  periodEn           String   @map("period_en")
  durationId         String   @map("duration_id")
  durationEn         String   @map("duration_en")
  typeId             String   @map("type_id")
  typeEn             String   @map("type_en")
  modeId             String   @map("mode_id")
  modeEn             String   @map("mode_en")
  responsibilitiesId String[] @map("responsibilities_id")
  responsibilitiesEn String[] @map("responsibilities_en")
  insightId          String[] @map("insight_id")
  insightEn          String[] @map("insight_en")
  impactId           String[] @map("impact_id")
  impactEn           String[] @map("impact_en")

  sortOrder          Int      @default(0) @map("sort_order")
  isPublished        Boolean  @default(true) @map("is_published")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("experiences")
}

model Resume {
  id          String   @id @default(cuid())
  
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  fileSize    Int      @map("file_size")
  
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("resumes")
}




